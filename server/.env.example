# ---- Runtime ----
NODE_ENV=development
PORT=5000
# Public URL of the website (used for canonical URLs, sitemap, referral links)
SITE_URL=http://localhost:5173
# Comma-separated list of allowed browser origins for CORS
CLIENT_ORIGINS=http://localhost:5173

# ---- Database ----
MONGODB_URI=mongodb://127.0.0.1:27017/hospitality369

# ---- Auth ----
# Use a long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=8h

# ---- Initial Super Admin (created by `npm run seed` if none exists) ----
SUPERADMIN_NAME=Super Admin
SUPERADMIN_EMAIL=superadmin@hospitality369.com
SUPERADMIN_PASSWORD=ChangeMe!2026

# ---- Resume storage ----
# local = private folder on disk (never served publicly); s3 = AWS S3 (requires: npm i @aws-sdk/client-s3)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=storage/resumes
MAX_RESUME_MB=5
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
